{
  "name": "entame-geo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\"",
    "measure": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/cli/measure.ts",
    "sync": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/cli/sync.ts",
    "estimate": "node --experimental-strip-types --no-warnings scripts/estimate-budget.ts",
    "facts:import": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/cli/facts-import.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:demo": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}

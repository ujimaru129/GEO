# 計測エンジンの API キー（Vercel では環境変数に設定。コードには置かない）
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
# Supabase の接続文字列（未設定なら data/local/ に JSONL で保存）
DATABASE_URL=

# 運営コンソールのログイン（Supabase のメールログイン）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# メールのログインリンクの戻り先（本番のURL）
NEXT_PUBLIC_SITE_URL=
# DATABASE_URL なしのデモ表示を本番ビルドで許可する（営業デモ用のプレビュー環境だけ 1）
ALLOW_DEMO=
